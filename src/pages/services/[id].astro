---
import Layout from '../../layouts/Layout.astro'
import { ServiceDetailPage } from '../../components/ServiceDetailPage'
import de from '../../locales/de.json' with { type: 'json' }

export function getStaticPaths() {
  // Build a static page per service ID defined in the locale file.
  const services = (de as any).servicesDetail ?? {}
  return Object.keys(services).map((id) => ({
    params: { id },
    props: { service: services[id] },
  }))
}

const { id } = Astro.params
const { service } = Astro.props

const title = service?.metaTitle ?? `${service?.title ?? 'Service'} — TW Services`
const description =
  service?.metaDescription ?? service?.subtitle?.split('\n')[0] ?? 'TW Services'

// Per-route Schema.org: Service with provider link to the Organization @id.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `https://www.tw-services.ch/services/${id}#service`,
      name: service?.title ?? id,
      description: service?.subtitle ?? '',
      provider: { '@id': 'https://www.tw-services.ch/#organization' },
      serviceType: service?.tagline ?? 'Werbefilm-Produktion',
      areaServed: [
        { '@type': 'Country', name: 'Switzerland' },
        { '@type': 'Country', name: 'Germany' },
        { '@type': 'Country', name: 'Austria' },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://www.tw-services.ch/' },
        {
          '@type': 'ListItem',
          position: 2,
          name: service?.title ?? id,
          item: `https://www.tw-services.ch/services/${id}`,
        },
      ],
    },
  ],
}
---

<Layout
  title={title}
  description={description}
  canonical={`https://www.tw-services.ch/services/${id}`}
  jsonLd={jsonLd}
>
  <ServiceDetailPage id={id!} client:load />
</Layout>
